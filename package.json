{
  "name": "mock-vercel-sandbox",
  "version": "1.0.0",
  "description": "Mock implementation of Vercel Sandbox API for local development and testing",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "sandbox": "tsx src/sandbox.ts",
    "docker:build": "docker build -t mock-vercel-sandbox .",
    "docker:run": "docker run -d --rm --name mock-vercel-sandbox mock-vercel-sandbox",
    "docker:stop": "docker stop mock-vercel-sandbox",
    "docker:exec": "docker exec -it mock-vercel-sandbox"
  },
  "keywords": [
    "vercel",
    "sandbox",
    "mock",
    "docker",
    "testing"
  ],
  "author": "Charles Francoise",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.18.0",
  "devDependencies": {
    "@types/dockerode": "^3.3.45",
    "@types/node": "^24.9.2",
    "@vercel/sandbox": "^1.0.2",
    "dotenv": "^17.2.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vercel": "^48.7.1"
  },
  "dependencies": {
    "dockerode": "^4.0.9"
  }
}
